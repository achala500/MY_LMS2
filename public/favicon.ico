<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <rect width="64" height="64" rx="14" fill="#FBF9F5"/>
  <rect x="2" y="2" width="60" height="60" rx="12" fill="none" stroke="#E5DDD0" stroke-width="1.5"/>
  
  <!-- Subtle Archival Watermark Circle -->
  <circle cx="32" cy="32" r="22" fill="none" stroke="#132219" stroke-width="0.75" stroke-opacity="0.15" stroke-dasharray="2 3"/>
  
  <!-- Stylized Serif 'S' Monogram in Deep Forest Ink -->
  <path d="M38 18 C33 18 25 20.5 25 26.5 C25 34 39 31 39 38 C39 43 32 44.5 27 43.5 M25 42 L25 46 C30 47.5 41 46.5 41 38 C41 29 27 32 27 25.5 C27 21 34 20 37.5 20.5 L38 18 Z" fill="#132219"/>
  
  <!-- Terracotta Bookmark / Seal dot -->
  <circle cx="43" cy="22" r="3.5" fill="#C85A32"/>
  
  <!-- Book Spine / Horizon Line -->
  <line x1="16" y1="52" x2="48" y2="52" stroke="#C85A32" stroke-width="2" stroke-linecap="round"/>
</svg>
